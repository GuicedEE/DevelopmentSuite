# Local development — simulates Azure Container Apps environment
# These values are injected by the ACA platform when deployed, but must be set manually for local dev.

# Required for runtime-autoconfigure to detect ACA environment
CONTAINER_APP_NAME=website-backend
CONTAINER_APP_ENV_DNS_SUFFIX=whitegrass-2e17714c.ukwest.azurecontainerapps.io

# Server
HTTP_ENABLED=true
HTTP_PORT=8080

# JWT (use a dev keystore)
JWT_KEYSTORE_PATH=keystore.p12
JWT_KEYSTORE_PASSWORD=changeit

