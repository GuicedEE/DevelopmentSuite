<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>
    <parent><groupId>com.guicedee</groupId><artifactId>parent</artifactId><version>2.6.0</version></parent>
    <groupId>com.guicedee</groupId><artifactId>native-image</artifactId><version>2.6.0</version>
    <name>GuicedEE Native Image Support</name>
    <description>Optional build-time Guice interception and reflection registration for native images.</description>

    <scm>
        <url>https://github.com/GuicedEE/DevelopmentSuite</url>
        <connection>scm:git:https://github.com/GuicedEE/DevelopmentSuite.git</connection>
        <developerConnection>scm:git:https://github.com/GuicedEE/DevelopmentSuite.git</developerConnection>
    </scm>

    <properties><maven.compiler.release>25</maven.compiler.release><ignore.moditect>true</ignore.moditect></properties>
    <dependencyManagement><dependencies>
        <dependency><groupId>com.guicedee</groupId><artifactId>guicedee-bom</artifactId><version>2.6.0</version><type>pom</type><scope>import</scope></dependency>
    </dependencies></dependencyManagement>
    <dependencies>
        <dependency><groupId>com.guicedee.modules.services</groupId><artifactId>guice</artifactId></dependency>
        <dependency><groupId>org.graalvm.sdk</groupId><artifactId>nativeimage</artifactId><version>25.0.4.1</version><scope>provided</scope></dependency>
        <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency>
        <dependency><groupId>org.mockito</groupId><artifactId>mockito-core</artifactId><scope>test</scope></dependency>
    </dependencies>
    <build><plugins>
        <plugin><groupId>com.guicedee.maven</groupId><artifactId>flatten-maven-plugin</artifactId></plugin>
        <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-antrun-plugin</artifactId></plugin>
        <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-javadoc-plugin</artifactId></plugin>
    </plugins></build>
</project>
